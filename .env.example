# ---------- Flagsmith (server-side only, never exposed to the browser) ----------
# Base URL of the Flagsmith API. Change for self-hosted instances (no trailing /api/v1).
FLAGSMITH_API_URL=https://api.flagsmith.com
# Organisation API token: Organisation Settings > API Keys
FLAGSMITH_API_TOKEN=
# Numeric project ID (visible in the dashboard URL: /project/<id>/...)
FLAGSMITH_PROJECT_ID=
# Environment: numeric ID or the environment API key (the client-side key shown in SDK Keys)
FLAGSMITH_ENVIRONMENT_ID=
# Optional: a second environment (ID or key) for "staging vs production" drift comparison
FLAGSMITH_COMPARE_ENVIRONMENT_ID=
# Optional: secret configured on the Flagsmith environment webhook (enables signature checks)
FLAGSMITH_WEBHOOK_SECRET=
# Optional: request timeout and cache TTL
FLAGSMITH_TIMEOUT_MS=8000
FLAGSMITH_CACHE_TTL_MS=15000

# ---------- AI provider (any OpenAI-compatible chat completions API) ----------
LLM_PROVIDER=groq
LLM_API_KEY=
# Defaults per provider are used when these are blank
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=20000

# ---------- Storage ----------
# SQLite file for snapshots, investigations and recoveries
FLAGREPLAY_DB_PATH=./data/flagreplay.db
